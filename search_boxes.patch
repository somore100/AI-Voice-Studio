+        """A drop-down you can type into. Typing filters the list (entries
+        that START with what you typed first, then entries that contain it)
+        in our own popup, which never takes keyboard focus - so you keep
+        typing. Up/Down move, Enter picks, Esc cancels, click picks.
+        `var` only ever receives a real entry, never half-typed text.
+        Use cb.set_values(list) to change the list and state "normal" /
+        "disabled" (not "readonly"); cb.set(v) / cb.get() act on `var`."""
+        import tkinter.font as tkfont
+        root = self.root
+        disp = tk.StringVar(value=var.get())
+        cb = ttk.Combobox(parent, textvariable=disp, width=width,
+                          font=("Segoe UI", 9))
+        st = {"values": list(full_values), "matches": [], "pop": None, "lb": None}
+        NAV = {"Up", "Down", "Return", "KP_Enter", "Escape", "Tab", "ISO_Left_Tab",
+               "Left", "Right", "Home", "End", "Shift_L", "Shift_R", "Control_L",
+               "Control_R", "Alt_L", "Alt_R", "Caps_Lock"}
+
+        def _disabled():
+            return str(cb.cget("state")) == "disabled"
+
+        def _commit(value):
+            var.set(value)
+            disp.set(value)
+
+        def _sync_in(*_):
+            if disp.get() != var.get():
+                disp.set(var.get())
+        var.trace_add("write", _sync_in)
+
+        def _hide(revert=False):
+            pop = st["pop"]
+            if pop is not None:
+                try:
+                    pop.destroy()
+                except tk.TclError:
+                    pass
+            st["pop"] = st["lb"] = None
+            if revert:
+                disp.set(var.get())
+
+        def _rank(typed):
+            vals = st["values"]
+            if not typed:
+                return list(vals)
+            t = typed.lower()
+            first = [v for v in vals if v.lower().startswith(t)]
+            rest = [v for v in vals if t in v.lower() and v not in first]
+            return first + rest
+
+        def _pick_from_listbox(index):
+            if st["matches"] and 0 <= index < len(st["matches"]):
+                _commit(st["matches"][index])
+            _hide()
+            cb.icursor("end")
+            cb.selection_range(0, "end")
+
+        def _show(matches, current=None):
+            if _disabled():
+                return
+            if not matches:
+                _hide()
+                return
+            st["matches"] = matches
+            rows = min(len(matches), 10)
+            if st["pop"] is None:
+                pop = tk.Toplevel(root)
+                pop.withdraw()
+                pop.overrideredirect(True)
+                pop.configure(bg=BORDER)
+                frm = tk.Frame(pop, bg=SURFACE)
+                frm.pack(padx=1, pady=1, fill="both", expand=True)
+                lb = tk.Listbox(frm, exportselection=False, activestyle="none",
+                                bg=SURFACE, fg=FG, selectbackground=CYAN,
+                                selectforeground=BG, highlightthickness=0,
+                                borderwidth=0, font=("Segoe UI", 9), takefocus=0)
+                sb = ttk.Scrollbar(frm, orient="vertical", command=lb.yview,
+                                   takefocus=0)
+                lb.configure(yscrollcommand=sb.set)
+                lb.pack(side="left", fill="both", expand=True)
+                st["sb"] = sb
+                st["pop"], st["lb"] = pop, lb
+                # Listbox's own click binding would grab keyboard focus;
+                # take over the mouse handling so focus stays in the entry.
+                lb.bind("<Button-1>", lambda e: "break")
+                lb.bind("<B1-Motion>", lambda e: "break")
+                lb.bind("<ButtonRelease-1>",
+                        lambda e: (_pick_from_listbox(lb.nearest(e.y)), "break")[1])
+                lb.bind("<Motion>", lambda e: (lb.selection_clear(0, "end"),
+                                               lb.selection_set(lb.nearest(e.y))))
+            lb = st["lb"]
+            lb.delete(0, "end")
+            lb.insert("end", *matches)
+            lb.configure(height=rows)
+            if len(matches) > rows:
+                st["sb"].pack(side="right", fill="y")
+            else:
+                st["sb"].pack_forget()
+            f = tkfont.Font(font=("Segoe UI", 9))
+            need = max(f.measure(m) for m in matches[:300]) + 36
+            w = max(cb.winfo_width(), min(need, 560))
+            root.update_idletasks()
+            x = cb.winfo_rootx()
+            y = cb.winfo_rooty() + cb.winfo_height()
+            h = rows * (f.metrics("linespace") + 2) + 4
+            if y + h > root.winfo_screenheight():
+                y = max(0, cb.winfo_rooty() - h)
+            st["pop"].geometry(f"{w}x{h}+{x}+{y}")
+            st["pop"].deiconify()
+            st["pop"].lift()
+            lb.selection_clear(0, "end")
+            idx = matches.index(current) if current in matches else 0
+            lb.selection_set(idx)
+            lb.see(idx)
+
+        def _on_key_release(e):
